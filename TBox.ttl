#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/jaehu/ontologies/2025/10/untitled-ontology-40/AA_1
:AA_1 rdf:type owl:NamedIndividual ,
               :MeasurementItem .


###  http://www.semanticweb.org/jaehu/ontologies/2025/10/untitled-ontology-40/AA_2
:AA_2 rdf:type owl:NamedIndividual ,
               :MeasurementItem .


###  http://www.semanticweb.org/jaehu/ontologies/2025/10/untitled-ontology-40/AC_1
:AC_1 rdf:type owl:NamedIndividual ,
               :MeasurementItem ,
               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                        owl:onProperty :appliesWhenFlowDirection ;
                                        owl:hasValue :LeftToRight_AlongProcessFlow
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :usesCenterEdgeRegion ;
                                        owl:hasValue :RightEdgeTopOf_CenterElectrodeSheet
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :usesUpperEdgeRegion ;
                                        owl:hasValue :RightEdgeTopOf_UpperElectrodeSheet
                                      ]
                                    ) ;
                 rdf:type owl:Class
               ] ,
               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                        owl:onProperty :appliesWhenFlowDirection ;
                                        owl:hasValue :RightToLeft_AlongProcessFlow
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :usesCenterEdgeRegion ;
                                        owl:hasValue :LeftEdgeTopOf_CenterElectrodeSheet
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :usesUpperEdgeRegion ;
                                        owl:hasValue :LeftEdgeTopOf_UpperElectrodeSheet
                                      ]
                                    ) ;
                 rdf:type owl:Class
               ] ;
      :measuredAt :FinalVision ,
                  :LongsideSealingVision ,
                  :MergeVision ;
      :measuresGapOf :AnodeCathode_Pair .


###  http://www.semanticweb.org/jaehu/ontologies/2025/10/untitled-ontology-40/AC_2
:AC_2 rdf:type owl:NamedIndividual ,
               :MeasurementItem ,
               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                        owl:onProperty :appliesWhenFlowDirection ;
                                        owl:hasValue :LeftToRight_AlongProcessFlow
                                      ]
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty :usesCenterEdgeRegion ;
                                        owl:hasValue :RightEdgeBottomOf_CenterElectrodeSheet
