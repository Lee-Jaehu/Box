'''

import vertexai
from vertexai.generative_models import GenerativeModel, Part, Content # Content import 추가

vertexai.init(project=PROJECT_ID, location=LOCATION)

model = GenerativeModel(MODEL_ID)

# 시스템 프롬프트 내용을 Part 객체로 변환합니다.
system_message_part = Part.from_text(system_prompt_content)

# 대화 세션 시작 시 system_instruction을 history의 첫 번째 메시지로 전달합니다.
# Content 객체를 from_dict 대신 직접 생성하여 parts 필드에 Part 객체 리스트를 전달합니다.
chat = model.start_chat(
    history=[
        Content(role="user", parts=[system_message_part]),
        Content(role="model", parts=[Part.from_text("네, 알겠습니다. 배터리 제조 공정 데이터 분석 및 온톨로지 변환에 대한 질문을 해주세요. 온톨로지 정의, 매핑 규칙, 그리고 SPC 및 MES 데이터를 종합적으로 활용하여 요청하신 형식으로 답변해 드리겠습니다.")])
    ]
)

print('✅ Gemini 챗봇 에이전트 설정 완료.')

import sys
import io
import traceback # 오류 스택 트레이스 출력을 위해 필요

# ==========================================
# 4. 인터랙티브 챗봇 실행 (Loop)
# ==========================================
# LLM의 응답을 파싱하여 지정된 형식으로 재구성하는 함수
def format_llm_response(llm_raw_text):
    # LLM이 지정된 형식을 잘 따른다고 가정하고, 그대로 반환합니다.
    # 만약 LLM이 [ ]만 포함된 원시 값을 반환하고 Python 코드에서 조립해야 한다면,
    # 이 함수 내에서 값을 추출하고 f-string으로 조립해야 합니다.
    return llm_raw_text

print('\n' + '='*50)
print('🚀 [Ontology Chatbot] 준비 완료! (종료하려면 \'exit\' 입력)')
print('='*50)

while True:
    # 사용자 입력 받기
    user_input = input('\nUser (질문하세요): ')
    
    if user_input.lower() in ['exit', 'quit', '종료']:
        print('챗봇을 종료합니다.')
        break
    
    # 데이터 구조 정보 (매 턴마다 갱신된 정보를 줄 수도 있음)
    # 이제 df_spc와 df_mes 두 개의 데이터프레임 정보를 제공합니다.
    data_info = f'''
[Current Data Info]
--- df_spc (SPC 검사 데이터) ---
Columns: {list(df_spc.columns)}
Head(3):
{df_spc.head(3).to_string()}

--- df_mes (MES 알람 이력 데이터) ---
Columns: {list(df_mes.columns)}
Head(3):
{df_mes.head(3).to_string()}
'''
    
    # 챗봇에게 전송할 최종 메시지
    full_query = f'''
    {user_input}
    
    필요하다면 'df_spc' 또는 'df_mes' 변수를 사용하는 파이썬 코드를 작성해.
    작성된 코드는 ```python ... ``` 블록 안에 넣어주고, 코드 실행 결과는 텍스트로 요약해서 답변해줘.
    데이터 정보: {data_info}
    '''
    
    print('🤔 Gemini 생각 중...')
    
    try:
        response = chat.send_message(full_query)
        
        # LLM의 응답에서 코드 블록과 일반 텍스트를 분리
        code_start_tag = '```python'
        code_end_tag = '```'
        
        code_block = None
        agent_text_output = response.text # 기본적으로 전체 응답 텍스트를 저장

        if code_start_tag in response.text:
            start_idx = response.text.find(code_start_tag) + len(code_start_tag)
            end_idx = response.text.find(code_end_tag, start_idx)

            if start_idx != -1 and end_idx != -1:
                code_block = response.text[start_idx:end_idx].strip()
                # 코드 블록을 제외한 나머지 텍스트를 에이전트의 응답으로 간주
                agent_text_output = response.text.replace(response.text[response.text.find(code_start_tag):end_idx + len(code_end_tag)], '', 1).strip() # 첫 번째 코드 블록만 제거

        # 에이전트의 텍스트 응답 출력
        formatted_response = format_llm_response(agent_text_output) # LLM의 순수 텍스트 답변 (코드 부분 제외)
        print("\n" + "="*20 + " Agent Response " + "="*20)
        print(f'{formatted_response}\n')
        
        if code_block: # 코드 블록이 존재하면 자동으로 실행
            print("\n--- 코드 자동 실행 ---")
            
            # exec 실행 시 출력을 캡처하기 위한 설정
            old_stdout = sys.stdout
            redirected_output = io.StringIO()
            sys.stdout = redirected_output

            try:
                # exec 함수에 globals()와 locals()를 전달하여 현재 스코프에서 변수를 사용 가능하게 함
                # df_spc, df_mes, pd 등의 변수가 exec 스코프에서 접근 가능하도록 합니다.
                exec(code_block, globals(), locals())
                
                captured_output = redirected_output.getvalue()
                if captured_output:
                    print("\n--- 코드 실행 결과 ---")
                    print(captured_output.strip()) # 캡처된 출력만 보여줌
                else:
                    print("코드 실행 결과: 출력 내용 없음")

            except Exception as e:
                print(f' ❌ 코드 실행 중 오류 발생: {e}')
                print("자세한 스택 트레이스:")
                traceback.print_exc() # 코드 실행 오류 스택 트레이스 출력
                print("--------------------")
            finally:
                sys.stdout = old_stdout # stdout을 다시 원래대로 복원
            
            print("--------------------") # 코드 실행 섹션 마무리
        
    except Exception as e:
        print(f'❌ 오류 발생: {e}')
        import traceback
        traceback.print_exc() # 챗봇 응답 오류 스택 트레이스 출력
