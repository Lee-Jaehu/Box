{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_exec_summary.schema.json",
  "title": "경영진 1장 요약 – EXAONE 출력 (칸별 문장)",
  "description": "AI가 쓰는 문장 칸만 담는다. 마일스톤·KPI 표는 코드가 채운다. emphasis는 background_conclusion에 그대로 있는 구절이어야 한다(코드 검사). 분량은 weekly_report/report_vars.py EXEC_BUDGET.",
  "type": "object",
  "required": ["title", "head_message", "background_conclusion", "emphasis", "left_title", "left_items", "right_title", "right_items"],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "type": "object",
      "required": ["text", "source_ids"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "properties": {
    "title": {"$ref": "#/$defs/item"},
    "head_message": {"$ref": "#/$defs/item"},
    "background_conclusion": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/item"}},
    "emphasis": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 2}},
    "left_title": {"$ref": "#/$defs/item"},
    "left_items": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/item"}},
    "right_title": {"$ref": "#/$defs/item"},
    "right_items": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/item"}}
  }
}
