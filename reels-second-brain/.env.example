# 값은 서버 환경변수로만 넣는다. 이 파일에 실제 값을 쓰지 않는다.
DATABASE_URL=postgresql://user:pass@host:5432/rsb
RSB_DATA_DIR=/var/lib/rsb
PUBLIC_BASE_URL=https://rsb.example.com
RSB_ADMIN_TOKEN=            # /admin/* 호출용 Bearer 토큰
RSB_TOKEN_KEY=              # Fernet 키: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCOUNT_ID=              # 세컨브레인 계정 ID(웹훅 recipient.id)
IG_ALLOWED_SENDER_IDS=      # 재후 본계정의 IGSID. 첫 DM 후 `python -m rsb.cli senders`로 확인
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://rsb.example.com/oauth/kakao/callback
KAKAO_ALLOWED_USER_ID=      # 첫 로그인 시 오류 메시지로 알려줌

OPENAI_API_KEY=
RSB_TRANSCRIBER=openai      # openai | faster-whisper
RSB_WHISPER_MODEL=whisper-1
RSB_VISION_MODEL=gpt-4.1-mini
