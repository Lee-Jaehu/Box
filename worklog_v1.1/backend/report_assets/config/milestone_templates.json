  "status_codes": [
    "예정",
    "진행",
    "지연",
    "완료",
    "보류",
    "취소"
  ],
  "table_columns": {
    "milestone": [
      "단계",
      "적용 범위",
      "Baseline",
      "계획",
      "실적",
      "상태",
      "비고"
    ],
    "performance": [
      "기간",
      "접수",
      "완료",
      "잔여",
      "주요 내용"
    ]
  },
  "rules": {
    "scope": {
      "common": "법인과 무관한 단계. 적용 범위에 \"공통\" 표시",
      "per_site": "과제 대상(법인·공정) 중에서 선택. 선택한 사이트 수만큼 하위 행 자동 생성 (예: 6-1, 6-2)"
    },
    "repeatable": "같은 단계를 회차로 반복 (예: 로직 개발 1차·2차, 심의 1차·2차). 회차마다 하위 행 생성",
    "date_allocation": "시작일~목표일 사이를 단계 weight 비율로 나눠 계획일 자동 배분, 주말이면 직전 평일로 당김, 마지막 단계 계획일 = 과제 목표일",
    "baseline": "팀장이 마일스톤을 확정하는 시점의 계획일을 Baseline으로 고정. 이후 변경은 계획일만 수정하고 변경 이력 기록",
    "customize": "단계 추가·삭제·이름 변경 허용. 추가 단계는 phase 지정 필수, 단계 code는 템플릿 code 유지 또는 S#-x 형식",
    "blue_text": "이번 주에 바뀐 계획·실적·비고 값은 RGB(0,0,255), 계획이 Baseline과 다르면 차이 일수 표시 (+n)",
    "max_rows": 9,
    "collapse": "9행 초과 시 완료된 하위 행부터 \"OO 완료 n개 사이트\" 한 행으로 접기",
    "versioning": "진행 중인 과제는 등록 당시 템플릿 버전 유지. 템플릿 개정은 신규 과제부터 적용"
  },
