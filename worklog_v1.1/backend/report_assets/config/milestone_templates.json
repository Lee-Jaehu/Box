  "meta": {
    "name": "업무 유형별 마일스톤 템플릿",
    "version": "0.1-draft",
    "status": "draft",
    "note": "표 구조(열)는 모든 유형 공통, 단계 목록만 유형별로 다름. 운영·상시 유형만 실적형 표 사용"
  },
  "phases": [
    {
      "code": "PLAN",
      "label": "기획",
      "desc": "현황 분석, 요구사항, 기획·심의 등 착수 전 단계"
    },
    {
      "code": "EXEC",
      "label": "개발·실행",
      "desc": "로직·시스템 개발, 발주·설치, 분석 수행"
    },
    {
      "code": "VERIFY",
      "label": "검증",
      "desc": "기능 검증, 테스트, 검수, 효과 검증"
    },
    {
      "code": "APPLY",
      "label": "적용",
      "desc": "양산·운영 적용, 배포"
    },
    {
      "code": "EXPAND",
      "label": "확산",
      "desc": "타 법인·라인·호기 수평전개"
    },
    {
      "code": "CLOSE",
      "label": "종료",
      "desc": "최종 효과 산출, 운영 인계, 정산, 회고"
    }
