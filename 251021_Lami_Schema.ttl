###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TopElectrode
:TopElectrode rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Electrode
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :hasPolarity ;
                                                           owl:hasValue :CathodeRole
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :Electrode ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :isPlacedOn ;
                                owl:someValuesFrom :TopSeparator
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :hasFeature ;
                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :CathodeTab
                              ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TopElectrodeCut
:TopElectrodeCut rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :TopElectrode
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasForm ;
                                                              owl:hasValue :Cut
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :TopElectrode .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TopElectrodeRoll
:TopElectrodeRoll rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :TopElectrode
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasForm ;
                                                               owl:hasValue :Roll
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :TopElectrode .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TopSeparator
:TopSeparator rdf:type owl:Class ;
              rdfs:subClassOf :Separator ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty :isPlacedOn ;
                                owl:someValuesFrom :CenterElectrode
                              ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TopSeparatorCut
:TopSeparatorCut rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :TopSeparator
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasForm ;
                                                              owl:hasValue :Cut
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :TopSeparator .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TopSeparatorRoll
:TopSeparatorRoll rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( :TopSeparator
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty :hasForm ;
                                                               owl:hasValue :Roll
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf :TopSeparator .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/WidthDefect
:WidthDefect rdf:type owl:Class ;
             rdfs:subClassOf :Defect .


