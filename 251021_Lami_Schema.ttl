     rdfs:subClassOf :PositionDefect ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresDistanceTo ;
                       owl:allValuesFrom :CathodeSide
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresPositionOf ;
                       owl:allValuesFrom :CathodeTab
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :usesReferencePoint ;
                       owl:allValuesFrom :TabSideEdge
                     ] .


