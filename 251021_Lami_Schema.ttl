@prefix : <http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/> .

<http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10> rdf:type owl:Ontology ;
                                                                           owl:imports <http://www.w3.org/2004/02/skos/core> .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/appliesWhenDirection
:appliesWhenDirection rdf:type owl:ObjectProperty ;
                      rdfs:domain :FieldPointMapping ;
                      rdfs:range :MovementDirection .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/appliesWhenSequenceRole
:appliesWhenSequenceRole rdf:type owl:ObjectProperty ;
                         rdfs:domain :FieldPointMapping ;
                         rdfs:range :CellSequenceRole .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/belongsToEquipment
:belongsToEquipment rdf:type owl:ObjectProperty ;
                    rdfs:domain :Electrode ;
                    rdfs:range :Equipment .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasDirection
:hasDirection rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Equipment ;
              rdfs:range :MovementDirection .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasFeature
:hasFeature rdf:type owl:ObjectProperty ;
            owl:inverseOf :isFeatureOf ;
            rdfs:domain :Electrode ;
            rdfs:range :Feature .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasFinalForm
:hasFinalForm rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :LayeredPart ;
              rdfs:range :Form .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasForm
:hasForm rdf:type owl:ObjectProperty ,
                  owl:FunctionalProperty ;
         rdfs:domain :LayeredPart ;
         rdfs:range :Form .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasFunction
:hasFunction rdf:type owl:ObjectProperty ;
             rdfs:domain :SemiProduct ;
             rdfs:range skos:Concept .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasInitialForm
:hasInitialForm rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :LayeredPart ;
                rdfs:range :Form .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasInput
:hasInput rdf:type owl:ObjectProperty ;
          rdfs:domain :Process ;
          rdfs:range :Material .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasPart
:hasPart rdf:type owl:ObjectProperty ,
                  owl:TransitiveProperty ;
         rdfs:domain :Process ;
         rdfs:range :Process .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasPattern
:hasPattern rdf:type owl:ObjectProperty ;
            rdfs:domain :SpacingDefect ;
            rdfs:range :MeasurementPattern .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasPolarity
:hasPolarity rdf:type owl:ObjectProperty ;
             rdfs:domain :LayeredPart ;
             rdfs:range :Polarity .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasRequiredTabSide
:hasRequiredTabSide rdf:type owl:ObjectProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain :Electrode ;
                    rdfs:range :ProductSidePosition .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/hasSidePosition
:hasSidePosition rdf:type owl:ObjectProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain :ElectrodeTab ;
                 rdfs:range :ProductSidePosition .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/involvesCellSequence
:involvesCellSequence rdf:type owl:ObjectProperty ;
                      rdfs:domain :PositionDefect ;
                      rdfs:range :CellSequenceRole .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isComposedOf
:isComposedOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasPart .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isCoverdAboveBy
:isCoverdAboveBy rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isSurroundedBy .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isCutBy
:isCutBy rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :participatesWith ;
         rdfs:domain :SemiProduct ;
         rdfs:range :Equipment .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isFeatureOf
:isFeatureOf rdf:type owl:ObjectProperty ;
             rdfs:domain :Feature ;
             rdfs:range :SemiProduct .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isLargerThan
:isLargerThan rdf:type owl:ObjectProperty ;
              owl:inverseOf :isSmallerThan ;
              rdfs:domain :LayeredPart ;
              rdfs:range :LayeredPart .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isPlacedOn
:isPlacedOn rdf:type owl:ObjectProperty ;
            rdfs:domain :Material ;
            rdfs:range :Material .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isRelevantToStageBefore
:isRelevantToStageBefore rdf:type owl:ObjectProperty ;
                         rdfs:domain :Defect ;
                         rdfs:range :SubProcess .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isSmallerThan
:isSmallerThan rdf:type owl:ObjectProperty ,
                        owl:AsymmetricProperty ,
                        owl:TransitiveProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain :LayeredPart ;
               rdfs:range :LayeredPart .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isStackedOn
:isStackedOn rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isPlacedOn .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isSupportedBelowBy
:isSupportedBelowBy rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :isSurroundedBy .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/isSurroundedBy
:isSurroundedBy rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/mapsField
:mapsField rdf:type owl:ObjectProperty ;
           rdfs:domain :FieldPointMapping ;
           rdfs:range :GapDataField .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/mapsToPoint
:mapsToPoint rdf:type owl:ObjectProperty ;
             rdfs:domain :FieldPointMapping ;
             rdfs:range :MeasurementPoint .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresDistanceTo
:measuresDistanceTo rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :measuresTarget ;
                    rdfs:domain :PositionDefect ;
                    rdfs:range :SideFeature .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresFeature
:measuresFeature rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :measuresTarget ;
                 rdfs:domain :WidthDefect ;
                 rdfs:range :ElectrodeTab .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresFromFeature
:measuresFromFeature rdf:type owl:ObjectProperty ;
                     rdfs:domain :PositionDefect ;
                     rdfs:range :EdgeFeature .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresGap
:measuresGap rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :measuresTarget ;
             rdfs:domain :GapDefect ;
             rdfs:range skos:Concept .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresPositionOf
:measuresPositionOf rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :measuresTarget ;
                    rdfs:domain :PositionDefect ;
                    rdfs:range :ElectrodeTab .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresTarget
:measuresTarget rdf:type owl:ObjectProperty ;
                rdfs:domain :Defect ;
                rdfs:range [ rdf:type owl:Class ;
                             owl:unionOf ( :GapDefect
                                           :PositionDefect
                                           :WidthDefect
                                         )
                           ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/measuresToRole
:measuresToRole rdf:type owl:ObjectProperty ;
                rdfs:domain :PositionDefect ;
                rdfs:range skos:Concept .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/participatesWith
:participatesWith rdf:type owl:ObjectProperty ;
                  rdfs:domain :SemiProduct ;
                  rdfs:range :Equipment .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/precedes
:precedes rdf:type owl:ObjectProperty ,
                   owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :SubProcess ;
          rdfs:range :SubProcess .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/produces
:produces rdf:type owl:ObjectProperty ;
          rdfs:domain :Process ;
          rdfs:range :Material .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/usesReferencePoint
:usesReferencePoint rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :measuresTarget ;
                    rdfs:domain :PositionDefect ;
                    rdfs:range :MeasurementReference .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/layerIndex
:layerIndex rdf:type owl:DatatypeProperty ;
            rdfs:domain :LayeredPart ;
            rdfs:range xsd:integer .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/operationOrder
:operationOrder rdf:type owl:DatatypeProperty ;
                rdfs:domain :SubProcess ;
                rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/AA
:AA rdf:type owl:Class ;
    rdfs:subClassOf :SpacingDefect ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :hasPattern ;
                      owl:hasValue :ConsecutivePair
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :isRelevantToStageBefore ;
                      owl:hasValue <http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10#TE(Cut)_TS(Cut)_CE(Cut)_BS(Cut)>
                    ] ,
                    [ rdf:type owl:Restriction ;
                      owl:onProperty :measuresGap ;
                      owl:hasValue :Anode
                    ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/AC_Gap
:AC_Gap rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :GapDefect
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :measuresGap ;
                                                     owl:hasValue :Anode
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :measuresGap ;
                                                     owl:hasValue :Cathode
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :GapDefect ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :measuresGap ;
                          owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                          owl:onClass skos:Concept
                        ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/AS_Gap
:AS_Gap rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :GapDefect
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :measuresGap ;
                                                     owl:hasValue :Anode
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :measuresGap ;
                                                     owl:hasValue :Separator
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :GapDefect ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :measuresGap ;
                          owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                          owl:onClass skos:Concept
                        ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/AnodeSide
:AnodeSide rdf:type owl:Class ;
           rdfs:subClassOf :SideFeature .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/AnodeTab
:AnodeTab rdf:type owl:Class ;
          rdfs:subClassOf :ElectrodeTab .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/BottomSeparator
:BottomSeparator rdf:type owl:Class ;
                 rdfs:subClassOf :Separator .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/BottomSeparatorCut
:BottomSeparatorCut rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :BottomSeparator
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasForm ;
                                                                 owl:hasValue :Cut
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :BottomSeparator .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/BottomSeparatorRoll
:BottomSeparatorRoll rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :BottomSeparator
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :hasForm ;
                                                                  owl:hasValue :Roll
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf :BottomSeparator .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CS_Gap
:CS_Gap rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :GapDefect
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :measuresGap ;
                                                     owl:hasValue :Cathode
                                                   ]
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :measuresGap ;
                                                     owl:hasValue :Separator
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :GapDefect ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :measuresGap ;
                          owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                          owl:onClass skos:Concept
                        ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CathodeSide
:CathodeSide rdf:type owl:Class ;
             rdfs:subClassOf :SideFeature .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CathodeTab
:CathodeTab rdf:type owl:Class ;
            rdfs:subClassOf :ElectrodeTab .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CellSequenceRole
:CellSequenceRole rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CenterElectrode
:CenterElectrode rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( :Electrode
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty :hasPolarity ;
                                                              owl:hasValue :AnodeRole
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf :Electrode ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :isPlacedOn ;
                                   owl:someValuesFrom :BottomSeparator
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasFeature ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass :AnodeTab
                                 ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CenterElectrodeCut
:CenterElectrodeCut rdf:type owl:Class ;
                    owl:equivalentClass [ owl:intersectionOf ( :CenterElectrode
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty :hasForm ;
                                                                 owl:hasValue :Cut
                                                               ]
                                                             ) ;
                                          rdf:type owl:Class
                                        ] ;
                    rdfs:subClassOf :CenterElectrode .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CenterElectrodeRoll
:CenterElectrodeRoll rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( :CenterElectrode
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty :hasForm ;
                                                                  owl:hasValue :Roll
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf :CenterElectrode .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/CutProcess
:CutProcess rdf:type owl:Class ;
            rdfs:subClassOf :SubProcess .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Cutter
:Cutter rdf:type owl:Class ;
        rdfs:subClassOf :Equipment .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Defect
:Defect rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/EdgeFeature
:EdgeFeature rdf:type owl:Class ;
             rdfs:subClassOf :Feature ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty :isFeatureOf ;
                               owl:someValuesFrom :Separator
                             ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Electrode
:Electrode rdf:type owl:Class ;
           rdfs:subClassOf :LayeredPart .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/ElectrodeTab
:ElectrodeTab rdf:type owl:Class ;
              rdfs:subClassOf :TabFeature .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Equipment
:Equipment rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Feature
:Feature rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/FieldPointMapping
:FieldPointMapping rdf:type owl:Class ;
                   rdfs:subClassOf [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                            owl:onProperty :appliesWhenDirection ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass :MovementDirection
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :mapsField ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass :GapDataField
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :mapsToPoint ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass :MeasurementPoint
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/FinalCutProcess
:FinalCutProcess rdf:type owl:Class ;
                 rdfs:subClassOf :SubProcess .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Form
:Form rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/GapDataField
:GapDataField rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/GapDefect
:GapDefect rdf:type owl:Class ;
           rdfs:subClassOf :Defect .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/LaminationProcess
:LaminationProcess rdf:type owl:Class ;
                   rdfs:subClassOf :Process ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasInput ;
                                     owl:someValuesFrom :BottomSeparator
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasInput ;
                                     owl:someValuesFrom :CenterElectrode
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasInput ;
                                     owl:someValuesFrom :MonoCell
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasInput ;
                                     owl:someValuesFrom :TopElectrode
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasInput ;
                                     owl:someValuesFrom :TopSeparator
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasPart ;
                                     owl:someValuesFrom :CutProcess
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasPart ;
                                     owl:someValuesFrom :MergeProcess
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :hasPart ;
                                     owl:someValuesFrom :RollProcess
                                   ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/LayeredPart
:LayeredPart rdf:type owl:Class ;
             rdfs:subClassOf :SemiProduct .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/Material
:Material rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/MeasurementPattern
:MeasurementPattern rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/MeasurementPoint
:MeasurementPoint rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/MeasurementReference
:MeasurementReference rdf:type owl:Class .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/MergeProcess
:MergeProcess rdf:type owl:Class ;
              rdfs:subClassOf :SubProcess .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/MonoCell
:MonoCell rdf:type owl:Class ;
          rdfs:subClassOf :SemiProduct ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPart ;
                            owl:someValuesFrom :BottomSeparator
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPart ;
                            owl:someValuesFrom :CenterElectrode
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPart ;
                            owl:someValuesFrom :TopElectrode
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasPart ;
                            owl:someValuesFrom :TopSeparator
                          ] .


