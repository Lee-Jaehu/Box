###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/TPA
:TPA rdf:type owl:Class ;
     rdfs:subClassOf :PositionDefect ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresDistanceTo ;
                       owl:allValuesFrom :AnodeSide
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresPositionOf ;
                       owl:allValuesFrom :AnodeTab
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :usesReferencePoint ;
                       owl:allValuesFrom :TabSideEdge
                     ] .


