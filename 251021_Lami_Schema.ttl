###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/SAG
:SAG rdf:type owl:Class ;
     rdfs:subClassOf :PositionDefect ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresFromFeature ;
                       owl:someValuesFrom :SealingSideEdge
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresFromFeature ;
                       owl:allValuesFrom :SealingSideEdge
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :involvesCellSequence ;
                       owl:hasValue :Leading_Cell
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :involvesCellSequence ;
                       owl:hasValue :Trailing_Cell
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :isRelevantToStageBefore ;
                       owl:hasValue <http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10#TE(Cut)_TS(Cut)_CE(Cut)_BS(Cut)>
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresToRole ;
                       owl:hasValue :Anode
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :involvesCellSequence ;
                       owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                       owl:onClass :CellSequenceRole
                     ] .


###  http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10/SCG
:SCG rdf:type owl:Class ;
     rdfs:subClassOf :PositionDefect ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresFromFeature ;
                       owl:someValuesFrom :SealingSideEdge
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresFromFeature ;
                       owl:allValuesFrom :SealingSideEdge
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :involvesCellSequence ;
                       owl:hasValue :Leading_Cell
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :involvesCellSequence ;
                       owl:hasValue :Trailing_Cell
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :isRelevantToStageBefore ;
                       owl:hasValue <http://www.semanticweb.org/jaehu/ontologies/2025/9/untitled-ontology-10#TE(Cut)_TS(Cut)_CE(Cut)_BS(Cut)>
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :measuresToRole ;
                       owl:hasValue :Cathode
                     ] ,
                     [ rdf:type owl:Restriction ;
                       owl:onProperty :involvesCellSequence ;
                       owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                       owl:onClass :CellSequenceRole
                     ] .


